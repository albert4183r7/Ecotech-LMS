# SQLite database. Prisma resolves relative paths from prisma/schema.prisma,
# not the project root — hence the leading '../'.
DATABASE_URL=file:../db/custom.db

# Google Gemini API key — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the model. Defaults to gemini-flash-latest.
# GEMINI_MODEL=gemini-pro-latest

# Optional: ImageKit, enables AI image generation inside slides.
# IMAGEKIT_URL_ENDPOINT=
# IMAGEKIT_PUBLIC_KEY=
# IMAGEKIT_PRIVATE_KEY=
