# SQLite database. Prisma resolves relative paths from prisma/schema.prisma,
# not the project root — hence the leading '../'.
DATABASE_URL=file:../db/custom.db

# Signing key for session cookies. At least 32 characters; required in
# production, where a missing key is a startup error rather than a default,
# because a predictable key means forgeable sessions.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ── Models ──────────────────────────────────────────────────────────────────
# The project runs open-source models locally through Ollama, which serves an
# OpenAI-compatible API. No key is needed.
#
#   ollama serve
#   ollama pull qwen2.5:14b-instruct     # planning, authoring, evaluation
#   ollama pull qwen2.5:7b-instruct      # short edits and judgements
#   ollama pull llama3.1:8b              # the lesson assistant
#   ollama pull llama3.2-vision:11b      # visual evaluation (needs to see)
#
# Optional: where the Ollama server is. Must be the OpenAI-compatible root,
# i.e. the path with /chat/completions under it.
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# Optional: only if Ollama sits behind a proxy that authenticates.
# OLLAMA_API_KEY=

# Optional: output ceiling per generation, and how long to wait for one.
# Local generation on CPU is slow; the default allows five minutes.
# OLLAMA_MAX_TOKENS=4096
# OLLAMA_TIMEOUT_MS=300000

# Optional: move one task to a different model. Every AI task has its own
# variable — see the table in docs/ARCHITECTURE.md, or src/lib/ai/models.ts.
# MODEL_OUTLINE_PLANNING=qwen2.5:14b-instruct
# MODEL_SLIDE_AUTHORING=qwen2.5:14b-instruct
# MODEL_SLIDE_FIELD_EDIT=qwen2.5:7b-instruct
# MODEL_SLIDE_HTML=qwen2.5:14b-instruct
# MODEL_QUIZ_AUTHORING=qwen2.5:14b-instruct
# MODEL_QUIZ_JUDGE=qwen2.5:7b-instruct
# MODEL_CONTENT_EVALUATION=qwen2.5:14b-instruct
# MODEL_VISUAL_EVALUATION=llama3.2-vision:11b
# MODEL_AGENT_TOOL_LOOP=qwen2.5:14b-instruct
# MODEL_LESSON_TUTOR=llama3.1:8b

# ── Previous providers (kept in src/lib/ai/previous-providers.ts) ────────────
# Claude via the EcoAPI gateway — https://www.ecoapi.ai/api
# ECOAPI_API_KEY=
# ECOAPI_BASE_URL=https://www.ecoapi.ai/api/v1
# CLAUDE_MODEL=claude-opus-5
# CLAUDE_MAX_TOKENS=16000
#
# Google Gemini, before that:
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-pro-latest

# Optional: ImageKit, enables AI image generation inside slides.
# IMAGEKIT_URL_ENDPOINT=
# IMAGEKIT_PUBLIC_KEY=
# IMAGEKIT_PRIVATE_KEY=

# Optional: point the slide renderer at a system Chromium instead of the copy
# Playwright downloads. Needed in slim containers.
# CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium
