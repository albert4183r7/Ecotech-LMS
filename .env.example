# SQLite database. Prisma resolves relative paths from prisma/schema.prisma,
# not the project root — hence the leading '../'.
DATABASE_URL=file:../db/custom.db

# Signing key for session cookies. At least 32 characters; required in
# production, where a missing key is a startup error rather than a default,
# because a predictable key means forgeable sessions.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ── Models ──────────────────────────────────────────────────────────────────
# Every model call goes through LangChain. On this branch it runs hosted models
# through an OpenAI-compatible gateway, so a key is required. The local,
# open-source mode is a separate branch:
#
#   git checkout claude/llm-open-source
#
# Required: the gateway's key.
ECOAPI_API_KEY=

# Optional: the gateway's OpenAI-compatible endpoint. Any provider that speaks
# that surface works — OpenRouter, Together, Azure, a vLLM server you host.
# ECOAPI_BASE_URL=https://www.ecoapi.ai/api/v1

# Optional: output ceiling per generation.
# CLAUDE_MAX_TOKENS=16000

# Optional: move one task to a different model. The ids are passed to the
# gateway verbatim, so they have to be ids it lists. Every AI task has its own
# variable — see the table in docs/ARCHITECTURE.md, or src/lib/ai/models.ts.
# MODEL_OUTLINE_PLANNING=claude-sonnet-5
# MODEL_DECK_AUTHORING=claude-sonnet-5
# MODEL_DECK_REVIEW=claude-sonnet-5
# MODEL_SLIDE_AUTHORING=claude-opus-5
# MODEL_SLIDE_FIELD_EDIT=claude-sonnet-5
# MODEL_VIDEO_SCRIPT_AUTHORING=claude-sonnet-5
# MODEL_SLIDE_HTML=claude-opus-5
# MODEL_QUIZ_AUTHORING=claude-opus-5
# MODEL_QUIZ_JUDGE=claude-sonnet-5
# MODEL_CONTENT_EVALUATION=claude-opus-5
# MODEL_VISUAL_EVALUATION=claude-opus-5
# MODEL_AGENT_TOOL_LOOP=claude-opus-5
# MODEL_LESSON_TUTOR=claude-sonnet-5

# ── Narrated lesson TTS ─────────────────────────────────────────────────────
# Free local OpenAI-compatible TTS. Start Speaches and download Kokoro once
# with `npm run tts:setup`. TTS_API_KEY is intentionally unnecessary locally.
TTS_BASE_URL=http://127.0.0.1:8000/v1
TTS_MODEL=speaches-ai/Kokoro-82M-v1.0-ONNX
TTS_VOICE=af_heart
TTS_TIMEOUT_MS=300000
TTS_CONCURRENCY=2

# To use another OpenAI-compatible speech provider, replace TTS_BASE_URL and
# set only the credential that provider accepts. Chat credentials are never
# sent to the TTS endpoint implicitly.
# TTS_API_KEY=

# ── Gemini, before LangChain (commented in src/lib/ai/previous-providers.ts) ─
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-pro-latest

# Optional: point the slide renderer at a system Chromium instead of the copy
# Playwright downloads. Needed in slim containers.
# CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium
