# SQLite database. Prisma resolves relative paths from prisma/schema.prisma,
# not the project root — hence the leading '../'.
DATABASE_URL=file:../db/custom.db

# Signing key for session cookies. At least 32 characters; required in
# production, where a missing key is a startup error rather than a default,
# because a predictable key means forgeable sessions.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# EcoAPI gateway key — https://www.ecoapi.ai/api
# The gateway serves Claude over an OpenAI-compatible surface.
ECOAPI_API_KEY=

# Optional: override the gateway base URL. Must be the OpenAI-compatible root,
# i.e. the path that has /chat/completions under it.
# ECOAPI_BASE_URL=https://www.ecoapi.ai/api/v1

# Optional: override the model. Defaults to claude-opus-5. Use whichever model
# id the gateway lists.
# CLAUDE_MODEL=claude-opus-5

# Optional: cap the tokens a single generation may produce. Defaults to 16000.
# CLAUDE_MAX_TOKENS=16000

# ── Google Gemini (previous provider, kept for a quick switch back) ──────────
# Restore the commented implementation at the bottom of src/lib/llm.ts, then:
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-pro-latest

# Optional: ImageKit, enables AI image generation inside slides.
# IMAGEKIT_URL_ENDPOINT=
# IMAGEKIT_PUBLIC_KEY=
# IMAGEKIT_PRIVATE_KEY=

# Optional: point the slide renderer at a system Chromium instead of the copy
# Playwright downloads. Needed in slim containers.
# CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium
