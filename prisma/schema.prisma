generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================
// User model for LMS
// ============================================
model User {
  id         String   @id @default(cuid())
  email      String   @unique
  password   String
  name       String?
  avatar     String?
  role       String   @default("student") // student, instructor
  department String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  enrollments    Enrollment[]
  favorites      Favorite[]
  quizAttempts   QuizAttempt[]
  createdCourses Course[]       @relation("CourseCreator")
  comments       Comment[]
  notes          Note[]
  ratings        Rating[]
  notifications  Notification[]
}

// ============================================
// Course categories for organization
// ============================================
model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  color       String? // Hex color code
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  courses Course[]
}

// ============================================
// Course model - main learning content unit
// ============================================
model Course {
  id           String   @id @default(cuid())
  title        String
  description  String?
  coverImage   String? // URL to cover image
  rating       Float    @default(0)
  studentCount Int      @default(0)
  status       String   @default("published") // draft, published, archived
  language     String   @default("english") // english, chinese
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  categoryId  String?
  category    Category?    @relation(fields: [categoryId], references: [id])
  creatorId   String?
  creator     User?        @relation("CourseCreator", fields: [creatorId], references: [id])
  lessons     Lesson[]
  enrollments Enrollment[]
  favorites   Favorite[]
  comments    Comment[]
  notes       Note[]
  ratings     Rating[]
}

// ============================================
// Lesson model - chapters/lessons within a course
// ============================================
model Lesson {
  id          String   @id @default(cuid())
  title       String
  order       Int      @default(0)
  outlineJson String? // Raw AI outline JSON (topic, style, per-slide title+outline) for re-generation
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  courseId   String
  course     Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  slides     Slide[]
  sections   Section[]
  quiz       Quiz?
  agentRuns  AgentRun[]
  progresses Progress[]
  comments   Comment[]
  notes      Note[]
}

// ============================================
// Slide model - individual slide within a lesson
// ============================================
model Slide {
  id        String   @id @default(cuid())
  title     String // Slide title from outline
  htmlBody  String // Full HTML+Tailwind document for iframe srcDoc
  status    String   @default("DRAFT_OUTLINE") // DRAFT_OUTLINE | GENERATING | READY | ERROR
  order     Int // Ordering position within the lesson
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Semantic slide content, from which htmlBody is rendered. Optional so
  // slides authored as raw HTML before this existed keep working.
  contentJson String?

  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  // A section owns several slides.
  sectionId String?
  section   Section? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  @@unique([lessonId, order])
  @@index([sectionId])
}

// ============================================
// Comment - course/lesson discussion
// ============================================
model Comment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lessonId String?
  lesson   Lesson?   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  courseId String
  course   Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId   String
  author   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentId String?
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentReplies")
}

// ============================================
// Enrollment - tracks user enrollment in courses
// ============================================
model Enrollment {
  id          String    @id @default(cuid())
  status      String    @default("in_progress") // in_progress, completed, dropped
  enrolledAt  DateTime  @default(now())
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  progresses   Progress[]
  quizAttempts QuizAttempt[]

  @@unique([userId, courseId])
}

// ============================================
// Note - user notes/bookmarks for course content
// ============================================
model Note {
  id           String   @id @default(cuid())
  content      String
  isBookmarked Boolean  @default(false)
  slideNumber  Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([userId, courseId])
}

// ============================================
// Progress - tracks user progress per lesson
// ============================================
model Progress {
  id             String   @id @default(cuid())
  completed      Boolean  @default(false)
  currentPage    Int      @default(1)
  lastAccessedAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lessonId     String
  lesson       Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lessonId])
}

// ============================================
// Favorite - user bookmarked courses
// ============================================
model Favorite {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

// ============================================
// Rating - user course ratings (1-5)
// ============================================
model Rating {
  id        String   @id @default(cuid())
  score     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

// ============================================
// Notification - user notifications
// ============================================
model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  type      String   @default("info") // info, success, warning, course, system, achievement
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================
// Agent runs
// Every run and step is recorded so a generation can be audited, resumed,
// and costed. Without this an agent failure is undiagnosable.
// ============================================

model AgentRun {
  id          String   @id @default(cuid())
  kind        String // lesson | deck
  status      String   @default("RUNNING") // RUNNING | FINISHED | FAILED | STOPPED
  stopReason  String? // finished | max-steps | token-budget | timeout | too-many-failures | error
  objective   String
  finalText   String?
  totalTokens Int      @default(0)
  durationMs  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lessonId String?
  lesson   Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  steps       AgentStep[]
  evaluations Evaluation[]

  @@index([lessonId])
  @@index([status])
}

model AgentStep {
  id        String   @id @default(cuid())
  index     Int
  text      String   @default("")
  toolCalls String   @default("[]") // JSON: name, args, ok, error, ms
  inTokens  Int      @default(0)
  outTokens Int      @default(0)
  createdAt DateTime @default(now())

  runId String
  run   AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, index])
}

model Evaluation {
  id        String   @id @default(cuid())
  scope     String // content | pedagogy | visual
  score     Int // 0-100
  passed    Boolean
  findings  String   @default("[]") // JSON: severity, slideId, problem, fix
  createdAt DateTime @default(now())

  runId String
  run   AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  slideId String?

  @@index([runId])
}

// ============================================
// Presentation sections
//
// A section is a logical part of the presentation, not a slide. The model
// decides how many sections a subject needs; the user decides how many slides
// they want. slideBudget is how many of those slides this section receives.
// ============================================

model Section {
  id          String   @id @default(cuid())
  title       String
  summary     String   @default("")
  subtopics   String   @default("[]") // JSON string[]
  slideBudget Int      @default(1)
  order       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lessonId String
  lesson   Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  slides   Slide[]

  @@unique([lessonId, order])
}

// ============================================
// Quiz
//
// Every lesson gets exactly one quiz, generated with the lesson rather than as
// a separate action, and grounded only in that lesson's own content. The
// one-to-one relation is enforced by the unique lessonId: a lesson cannot
// accumulate quizzes by being regenerated.
// ============================================

model Quiz {
  id        String   @id @default(cuid())
  title     String
  /**
   * DRAFT | READY | ERROR — mirrors the slide lifecycle.
   */
  status    String   @default("DRAFT")
  /**
   * Why generation failed, when status is ERROR.
   */
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lessonId String @unique
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  questions Question[]
  attempts  QuizAttempt[]
}

model Question {
  id          String   @id @default(cuid())
  prompt      String
  /**
   * Shown after submission. Optional; the agent writes one when it helps.
   */
  explanation String?
  /**
   * Image URL when the agent judged one pedagogically useful.
   */
  imageUrl    String?
  /**
   * The sentence from the lesson that supports the correct answer.
   * Recorded at generation time so grounding is auditable afterwards rather
   * than merely asserted: an instructor reviewing the quiz can see exactly
   * what the question was drawn from.
   */
  sourceQuote String?
  order       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  quizId String
  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)

  options Option[]
  answers StudentAnswer[]

  @@unique([quizId, order])
}

model Option {
  id        String  @id @default(cuid())
  text      String
  isCorrect Boolean @default(false)
  order     Int

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  chosenBy StudentAnswer[]

  @@unique([questionId, order])
}

// ============================================
// Quiz attempts
//
// Scored on submission, never by hand. The attempt hangs off the enrolment as
// well as the user so it sits inside the progress architecture that already
// exists rather than beside it.
// ============================================

model QuizAttempt {
  id           String   @id @default(cuid())
  /**
   * Percentage, 0-100.
   */
  score        Int
  correctCount Int
  totalCount   Int
  submittedAt  DateTime @default(now())

  quizId String
  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /**
   * Null only if the enrolment is later removed; the attempt still stands.
   */
  enrollmentId String?
  enrollment   Enrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)

  answers StudentAnswer[]

  @@index([userId, quizId])
  @@index([quizId])
}

model StudentAnswer {
  id        String  @id @default(cuid())
  isCorrect Boolean

  attemptId String
  attempt   QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  /**
   * Null when the question was left unanswered.
   */
  selectedOptionId String?
  selectedOption   Option? @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)

  @@unique([attemptId, questionId])
}
