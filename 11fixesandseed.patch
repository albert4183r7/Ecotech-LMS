From 17cb6bf38e918827a7140dbf131d2e80431da0b0 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 20 Aug 2026 07:12:39 +0000
Subject: [PATCH 3/3] Make the seed script runnable under node

db:seed failed immediately: node's ESM resolver requires explicit file
extensions, and prisma/seed.ts imported the app's db module by its
TypeScript path, so the run died with ERR_MODULE_NOT_FOUND before touching
the database. The script now creates its own PrismaClient, which also keeps
the app's query logging out of the seed output and closes the connection
deterministically.

Renamed to seed.mts so node treats it as an ES module by file extension,
which removes the MODULE_TYPELESS_PACKAGE_JSON warning without adding
"type": "module" to package.json and changing how every other script is
interpreted.

Verified end to end against a throwaway database: 5 users, 6 categories,
5 courses, 25 lessons, 25 slides created, no warnings.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01HTApKorFpaLx1vvsjzuQEc
---
 .prettierignore              | 2 +-
 package.json                 | 2 +-
 prisma/{seed.ts => seed.mts} | 8 +++++++-
 3 files changed, 9 insertions(+), 3 deletions(-)
 rename prisma/{seed.ts => seed.mts} (99%)

diff --git a/.prettierignore b/.prettierignore
index 190ce86..1e59c20 100644
--- a/.prettierignore
+++ b/.prettierignore
@@ -3,4 +3,4 @@ node_modules
 db
 public/uploads
 package-lock.json
-prisma/seed.ts
+prisma/seed.mts
diff --git a/package.json b/package.json
index 685de82..fc2f5ce 100755
--- a/package.json
+++ b/package.json
@@ -15,7 +15,7 @@
     "db:generate": "prisma generate",
     "db:migrate": "prisma migrate dev",
     "db:reset": "prisma migrate reset",
-    "db:seed": "node --experimental-strip-types prisma/seed.ts"
+    "db:seed": "node --experimental-strip-types prisma/seed.mts"
   },
   "dependencies": {
     "@dnd-kit/core": "^6.3.1",
diff --git a/prisma/seed.ts b/prisma/seed.mts
similarity index 99%
rename from prisma/seed.ts
rename to prisma/seed.mts
index fbb86a3..d99b66b 100755
--- a/prisma/seed.ts
+++ b/prisma/seed.mts
@@ -1,4 +1,10 @@
-import { db } from '../src/lib/db'
+// A seed script is run directly by node, whose ESM resolver requires explicit
+// file extensions, so it cannot import the app's db module by its TypeScript
+// path. Owning the client here also keeps the app's query logging out of the
+// seed output and closes the connection deterministically.
+import { PrismaClient } from '@prisma/client'
+
+const db = new PrismaClient()
 
 // ============================================================
 // Helper: build a full HTML+Tailwind slide document
